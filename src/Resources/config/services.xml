<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <!-- Services -->
        <service id="Emporiqa\ShopwarePlugin\Service\ConfigService"/>
        <service id="Emporiqa\ShopwarePlugin\Service\ConfigServiceInterface" alias="Emporiqa\ShopwarePlugin\Service\ConfigService"/>

        <service id="Emporiqa\ShopwarePlugin\Service\WebhookClient"/>
        <service id="Emporiqa\ShopwarePlugin\Service\WebhookClientInterface" alias="Emporiqa\ShopwarePlugin\Service\WebhookClient"/>

        <service id="Emporiqa\ShopwarePlugin\Service\ConnectService"/>
        <service id="Emporiqa\ShopwarePlugin\Service\ConnectServiceInterface" alias="Emporiqa\ShopwarePlugin\Service\ConnectService"/>

        <service id="Emporiqa\ShopwarePlugin\Service\ProductFormatter"/>
        <service id="Emporiqa\ShopwarePlugin\Service\ProductFormatterInterface" alias="Emporiqa\ShopwarePlugin\Service\ProductFormatter"/>

        <service id="Emporiqa\ShopwarePlugin\Service\CmsPageFormatter"/>
        <service id="Emporiqa\ShopwarePlugin\Service\CmsPageFormatterInterface" alias="Emporiqa\ShopwarePlugin\Service\CmsPageFormatter"/>

        <service id="Emporiqa\ShopwarePlugin\Service\ChannelResolver">
            <argument key="$salesChannelRepository" type="service" id="sales_channel.repository"/>
        </service>
        <service id="Emporiqa\ShopwarePlugin\Service\ChannelResolverInterface" alias="Emporiqa\ShopwarePlugin\Service\ChannelResolver"/>

        <service id="Emporiqa\ShopwarePlugin\Service\SyncService">
            <argument key="$productRepository" type="service" id="product.repository"/>
            <argument key="$landingPageRepository" type="service" id="landing_page.repository"/>
            <argument key="$categoryRepository" type="service" id="category.repository"/>
            <argument key="$salesChannelRepository" type="service" id="sales_channel.repository"/>
        </service>
        <service id="Emporiqa\ShopwarePlugin\Service\SyncServiceInterface" alias="Emporiqa\ShopwarePlugin\Service\SyncService"/>

        <!-- Message Queue -->
        <service id="Emporiqa\ShopwarePlugin\MessageQueue\Handler\WebhookMessageHandler"/>
        <service id="Emporiqa\ShopwarePlugin\MessageQueue\Handler\FullSyncMessageHandler"/>

        <!-- Subscribers -->
        <service id="Emporiqa\ShopwarePlugin\Subscriber\ProductSubscriber">
            <argument key="$productRepository" type="service" id="product.repository"/>
            <argument key="$connection" type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="Emporiqa\ShopwarePlugin\Subscriber\OrderSubscriber">
            <argument key="$orderRepository" type="service" id="order.repository"/>
            <argument key="$orderTransactionRepository" type="service" id="order_transaction.repository"/>
        </service>
        <service id="Emporiqa\ShopwarePlugin\Subscriber\LandingPageSubscriber">
            <argument key="$landingPageRepository" type="service" id="landing_page.repository"/>
        </service>
        <service id="Emporiqa\ShopwarePlugin\Subscriber\CategorySubscriber">
            <argument key="$categoryRepository" type="service" id="category.repository"/>
        </service>
        <service id="Emporiqa\ShopwarePlugin\Subscriber\CatalogChangeSubscriber"/>
        <service id="Emporiqa\ShopwarePlugin\Subscriber\StorefrontSubscriber"/>

        <!-- Controllers -->
        <service id="Emporiqa\ShopwarePlugin\Controller\CartController" public="true">
            <argument key="$productRepository" type="service" id="product.repository"/>
        </service>
        <service id="Emporiqa\ShopwarePlugin\Controller\OrderTrackingController" public="true">
            <argument key="$orderRepository" type="service" id="order.repository"/>
            <argument key="$eventDispatcher" type="service" id="event_dispatcher"/>
        </service>
        <service id="Emporiqa\ShopwarePlugin\Controller\UserTokenController" public="true"/>
        <service id="Emporiqa\ShopwarePlugin\Controller\Admin\ConnectController" public="true"/>
        <service id="Emporiqa\ShopwarePlugin\Controller\Admin\SyncController" public="true">
            <argument key="$productRepository" type="service" id="product.repository"/>
            <argument key="$landingPageRepository" type="service" id="landing_page.repository"/>
            <argument key="$categoryRepository" type="service" id="category.repository"/>
            <argument key="$salesChannelRepository" type="service" id="sales_channel.repository"/>
            <argument key="$propertyGroupRepository" type="service" id="property_group.repository"/>
            <argument key="$stateMachineStateRepository" type="service" id="state_machine_state.repository"/>
        </service>

        <!-- CLI Commands -->
        <service id="Emporiqa\ShopwarePlugin\Command\SyncProductsCommand"/>
        <service id="Emporiqa\ShopwarePlugin\Command\SyncPagesCommand"/>
        <service id="Emporiqa\ShopwarePlugin\Command\SyncAllCommand"/>
        <service id="Emporiqa\ShopwarePlugin\Command\TestConnectionCommand">
            <argument key="$productRepository" type="service" id="product.repository"/>
        </service>
    </services>
</container>
